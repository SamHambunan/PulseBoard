# use a lightweight node 20 image for local development
from node:20-alpine

# set the working directory inside the container
workdir /app

# copy only package files first to cache the npm install step
copy package*.json ./

# cleanly install exact dependencies
run npm ci

# copy the rest of the frontend code
copy . .

# expose vite's default dev server port
expose 5173

# start vite, binding to 0.0.0.0 so it is accessible outside the container
cmd ["npm", "run", "dev", "--", "--host", "0.0.0.0"]